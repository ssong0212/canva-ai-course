{
  "manifest_version": 3,
  "name": "Pixel Pets",
  "version": "1.0.0",
  "description": "A cute pixel pet that lives in your browser. It walks, naps, chases your cursor, and can be picked up.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Pixel Pets",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/pets.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
